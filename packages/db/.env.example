# --- Variables de entorno de packages/db ---
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear .env

# Estas variables solo se usan cuando @axioma/db corre en un entorno Node.js
# (apps/api, scripts de drizzle-kit, seed, migraciones, tests).
# El frontend nunca las lee.

# Base de datos principal (Turso/libSQL)
DATABASE_URL=libsql://axioma-prod.turso.io
DATABASE_AUTH_TOKEN=

# Base de datos para tests (puede apuntar a otra DB de Turso o a un archivo local)
TEST_DATABASE_URL=file::memory:?cache=shared
TEST_DATABASE_AUTH_TOKEN=
