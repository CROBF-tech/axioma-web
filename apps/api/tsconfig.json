{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@api/*": ["./apps/api/src/*"],
      "@axioma/db": ["./packages/db/src/index.ts"],
      "@axioma/db/schema": ["./packages/db/src/schema/index.ts"],
      "@axioma/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
